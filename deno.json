{
  "imports": {
    "@deno/emit": "jsr:@deno/emit@0.46.0"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
    "strict": true
  },
  "lint": {
    "include": ["src/zundler/assets_ts/", "scripts/"],
    "rules": {
      "exclude": [
        "no-unused-vars",
        "no-explicit-any",
        "no-empty",
        "require-await",
        "no-window",
        "no-window-prefix"
      ]
    }
  },
  "fmt": {
    "include": ["src/zundler/assets_ts/", "scripts/"],
    "useTabs": true,
    "lineWidth": 80
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env --allow-net --allow-import scripts/build_assets.ts"
  }
}
